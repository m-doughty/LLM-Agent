use Test;
use lib 'lib', 't/lib';
use AgentTestKit;
use JSON::Fast;
use LLM::Agent::Session;
use LLM::Chat::Conversation::Message;

# The transcript as a file: what a line looks like, when it hits the disk,
# and what the session refuses to do. Resuming one is t/08's job.

plan 16;

my $tmp = $*TMPDIR.add("llm-agent-t07-{$*PID}-{now.Int}");
$tmp.mkdir;
END {
	close-test-sessions();
	if $tmp.e {
		.unlink for $tmp.dir;
		$tmp.rmdir;
	}
}

my $n = 0;
sub fresh-path(--> IO::Path) { $tmp.add('s' ~ $n++ ~ '.jsonl') }

subtest 'the meta line comes first, and is exactly what was passed' => {
	plan 6;

	my $path = fresh-path();
	my $session = test-session(
		path => $path, meta => { agent => 'sadna', cwd => '/srv' },
	);

	my %first = from-json($path.lines.head);
	is %first<v>, 1, 'envelope version 1';
	is %first<type>, 'session-meta', 'the first line is the meta line';
	is-deeply %first<payload>, { agent => 'sadna', cwd => '/srv' },
		'carrying the caller’s hash verbatim — nothing added';
	ok %first<id>.chars, 'with an id';
	like %first<ts>, /^ \d**4 '-' \d\d '-' \d\d 'T' \d\d ':' \d\d ':' \d\d '.' \d+ 'Z' $/,
		'and an ISO-8601 UTC timestamp with sub-second precision — the '
			~ 'same shape LLM::Agent::Event stamps its events with';

	is-deeply $session.meta, { agent => 'sadna', cwd => '/srv' },
		'and .meta reads it back';

	$session.close;
};

subtest 'every line is on disk before the method returns' => {
	plan 3;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});

	# A SECOND handle on the same path, with the session still open. This
	# is the whole point of the flushed handle-mode writer: a `kill -9`
	# one instruction after append-message returns loses nothing.
	is $path.lines.elems, 1, 'the meta line is already visible';

	$session.append-message(msg('user', 'hello'));
	is $path.lines.elems, 2, 'and so is the message, before any close';

	my %line = from-json($path.lines[1]);
	is %line<payload><content>, 'hello', 'with its content intact';

	$session.close;
};

subtest 'a message line carries the message, and the extras carry the rest' => {
	plan 8;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});

	my $id = $session.append-message(
		msg('assistant', 'thinking about it',
			tool-calls => [{ id => 'c1', function => { name => 'fs_read' } },]),
		extra => { reasoning => 'first I will read it', usage => { 'prompt-tokens' => 12 } },
	);

	ok $id.chars, 'append-message hands back the envelope id';

	my %line = from-json($path.lines.tail);
	is %line<id>, $id, 'which is the id of the line it wrote';
	is %line<type>, 'message', 'typed as a message';
	is %line<payload><role>, 'assistant', 'with the role';
	is %line<payload><tool-calls>[0]<id>, 'c1', 'and the tool calls';
	is %line<payload><reasoning>, 'first I will read it',
		'the extras sit alongside, replay-visible';
	is %line<payload><usage><prompt-tokens>, 12, 'including structured ones';

	# ...and are dropped when a Message is rebuilt, because a Message has
	# nowhere to put them.
	nok $session.messages[0].can('reasoning'),
		'while the rebuilt Message has no idea about them';

	$session.close;
};

subtest 'an extra can never overwrite the message itself' => {
	plan 2;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});

	$session.append-message(
		msg('user', 'the real content'),
		extra => { role => 'assistant', content => 'a lie' },
	);

	is $session.messages[0].role, 'user', 'the role is the message’s own';
	is $session.messages[0].content, 'the real content', 'and so is the content';

	$session.close;
};

subtest 'grants are a whole snapshot, and the last one wins' => {
	plan 3;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});

	is-deeply $session.grants, (), 'no grants to begin with';

	$session.append-grants([{ tool => 'fs_read', decision => 'allow' },]);
	$session.append-grants([
		{ tool => 'fs_read', decision => 'allow' },
		{ tool => 'fs_write', decision => 'allow', under => '/srv/scratch' },
	]);

	is $session.grants.elems, 2,
		'the later, larger snapshot is what .grants answers';
	is $session.grants[1]<under>, '/srv/scratch', 'in full';

	$session.close;
};

subtest 'a run context is refused before it is written, or not at all' => {
	plan 8;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});

	sub append(*%args) {
		$session.append-run-context(
			run-id   => 'r1',
			digest   => 'd1',
			facts    => [date => 'today'],
			sections => [%(name => 'identity', digest => 'ds', rendered => 'I'),],
			|%args,
		);
	}

	my $id = append();
	ok $id.chars, 'a well-formed context is written and returns its id';
	is $session.elems, 2, 'as one line';
	is $session.messages.elems, 0,
		'and it is not a message, here or anywhere else';

	# Facts survive as ordered [key, value] rows rather than as an object,
	# because a JSON object has no order to preserve.
	is-deeply $session.events.tail<payload><facts>, (('date', 'today'),),
		'the facts are rows, in render order';

	throws-like { append(run-id => '  ') }, Exception, message => /'run-id'/,
		'a context that cannot say which run it belongs to is refused';
	throws-like { append(digest => '') }, Exception, message => /'digest'/,
		'and one with no digest to compare';
	throws-like { append(facts => ['date',]) }, Exception,
		message => /'a fact is a key'/,
		'a fact that is not a Pair (or a two-element row) is refused';
	throws-like { append(sections => [%(name => 'x', digest => 'y'),]) },
		Exception, message => /'has no rendered'/,
		'and a section with no body — there would be nothing to store, and '
			~ 'nothing for a later line to point at';

	$session.close;
};

subtest 'an elision is refused before it is written, or not at all' => {
	plan 9;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});

	my $one = $session.append-message(msg('assistant', 'reading',
		tool-calls => [tool-call('c1', 'fs_read', '{"path":"a"}'),]));
	my $two = $session.append-message(msg('tool', 'A' x 40, tool-call-id => 'c1'));

	my $id = $session.append-elision(
		items => [%(id => $two, stub => '[elided by the harness: 40-char result]'),],
	);
	ok $id.chars, 'a well-formed elision is written and returns its id';
	is $session.elems, 4, 'as one line';
	is $session.events.tail<type>, 'elision', 'of its own type';
	is-deeply $session.events.tail<payload><items>.map({ $_<id> }).List,
		($two,), 'naming the message it stubs, by envelope id';

	is $session.messages.elems, 2,
		'the conversation is the same LENGTH — an elision adds and removes '
			~ 'nothing';
	is $session.messages[1].content, '[elided by the harness: 40-char result]',
		'and the stub is what the message now says';
	is $session.messages[1].tool-call-id, 'c1',
		'while everything else about it is where it was';

	throws-like { $session.append-elision(items => []) }, Exception,
		message => /'cannot be empty'/,
		'an elision that stubs nothing is refused — a line that changes '
			~ 'nothing is not worth the bytes';
	throws-like {
		$session.append-elision(items => [%(id => 'no-such-id', stub => 'x'),])
	}, Exception, message => /'not a message this transcript still has'/,
		'and one naming a message that is not here is refused BEFORE the '
			~ 'write, exactly as a compaction naming nothing is';

	$session.close;
};

subtest 'the escape hatch writes unknown types, and refuses the known ones' => {
	plan 5;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});

	$session.append-message(msg('user', 'hi'));
	my $id = $session.append-event(
		type => 'app-checkpoint', payload => { step => 3 },
	);

	ok $id.chars, 'append-event returns an id like the rest';
	is $session.events.tail<type>, 'app-checkpoint',
		'the line is preserved in .events';
	is $session.messages.elems, 1,
		'and skipped by .messages, which only knows about conversations';

	throws-like { $session.append-event(type => 'message', payload => {}) },
		Exception, message => /'built-in type'/,
		'a built-in type must go through its own appender';
	throws-like { $session.append-event(type => '  ', payload => {}) },
		Exception, message => /'cannot be empty'/,
		'and a type has to be something';

	$session.close;
};

subtest 'events is a copy, nested payload included' => {
	plan 2;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});

	$session.append-message(msg('assistant', '', tool-calls => [
		{ id => 'c1', type => 'function',
		  function => { name => 'fs_read', arguments => '{"path":"a"}' } },
	]));

	my @before = $session.events;
	@before.tail<payload><tool-calls>[0]<function><name> = 'sabotage';

	my @after = $session.events;
	isnt @after.tail<payload><tool-calls>[0]<function><name>, 'sabotage',
		'mutating a returned envelope does not reach the replayed state';
	is @after.tail<payload><tool-calls>[0]<function><name>, 'fs_read',
		'the payload replay actually holds is untouched';

	$session.close;
};

subtest 'peek reads a transcript without touching it' => {
	plan 12;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => { agent => 'sadna' });
	$session.append-message(msg('user', 'get it looked at'));
	$session.append-message(msg('assistant', 'delegating', tool-calls => [
		{ id => 'c1', type => 'function',
		  function => { name => 'task', arguments => '{}' } },
	]));
	$session.append-message(msg('tool', 'STATUS: started', tool-call-id => 'c1'));
	$session.append-event(type => 'subagent-spawned',
		payload => { 'agent-id' => 'reviewer-1' });
	$session.close;

	my Int $before = $path.s;
	my %read = LLM::Agent::Session.peek(:$path);

	nok %read<error>.defined, 'a whole transcript reads without an error';
	is %read<meta><agent>, 'sadna', 'the meta line is the meta line';
	is %read<size>, $before, 'the size is the size it was read at';
	is-deeply %read<messages>.map({ .role }).List,
		('user', 'assistant', 'tool'),
		'every message line, in file order';
	is %read<messages>[1].tool-calls.elems, 1,
		'with its tool calls intact — one call, not a list holding one';
	is-deeply %read<envelopes>.map({ $_<type> }).List,
		('session-meta', 'message', 'message', 'message', 'subagent-spawned'),
		'and every envelope, including the ones messages skips';
	is $path.s, $before, 'nothing was written to the file';

	# THE CRASH TAIL, which is what `load` repairs off the end and this
	# deliberately does not: a viewer looking at a live writer must not
	# truncate the line it is halfway through.
	$path.spurt('{"v":1,"type":"mess', :append);
	my Int $after = $path.s;
	my %tail = LLM::Agent::Session.peek(:$path);

	nok %tail<error>.defined, 'a half-written last line is not an error';
	is %tail<messages>.elems, 3, 'the whole lines are all still there';
	is %tail<warnings>.elems, 1, 'and the broken one is a warning';
	is $path.s, $after,
		'the file still has its tail — peek repairs nothing';

	ok (LLM::Agent::Session.peek(path => $tmp.add('nowhere.jsonl'))<error>
		// '').contains('no transcript'),
		'a path with nothing at it says so rather than throwing';
};

subtest 'message-ids runs parallel to messages' => {
	plan 3;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});

	my @ids = (
		$session.append-message(msg('user', 'one')),
		$session.append-message(msg('assistant', 'two')),
	);

	is-deeply $session.message-ids, @ids.List,
		'in the order they were appended';
	is $session.messages.elems, $session.message-ids.elems,
		'one id per message';
	is $session.elems, 3, 'and .elems counts lines, meta included';

	$session.close;
};

subtest 'create refuses a file that already has a transcript in it' => {
	plan 3;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});
	$session.append-message(msg('user', 'precious'));
	$session.close;

	throws-like { test-session(path => $path, meta => {}) },
		Exception, message => /'append-only'/,
		'a transcript is never opened over';

	is $path.lines.elems, 2, 'and the existing one is untouched';

	# An empty file is not a transcript, so creating over one is fine —
	# that is what a `touch` or a failed previous attempt leaves.
	my $empty = fresh-path();
	$empty.spurt('');
	lives-ok { test-session(path => $empty, meta => {}).close },
		'though an empty file is fair game';
};

subtest 'load refuses what it cannot read' => {
	plan 2;

	throws-like { reopen-session(path => $tmp.add('nope.jsonl')) },
		Exception, message => /'no transcript'/,
		'a path with nothing at it';

	throws-like { LLM::Agent::Session.new(path => fresh-path()) },
		Exception, message => /'.create'/,
		'and .new is not the way in — a session is created or resumed';
};

subtest 'a closed session refuses to append, but still reads' => {
	plan 3;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});
	$session.append-message(msg('user', 'hello'));
	$session.close;

	throws-like { $session.append-message(msg('user', 'more')) },
		Exception, message => /'closed'/,
		'appending after close is refused';
	is $session.messages.elems, 1, 'while what it replayed stays readable';
	lives-ok { $session.close }, 'and closing twice is harmless';
};

subtest 'a line that cannot be written changes nothing in memory' => {
	plan 7;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});
	$session.append-message(msg('user', 'landed'));

	# The handle taken out from under it, which is the closest a test can
	# portably get to a full disk — and the same shape of failure: the
	# write throws after the session has decided to make the append.
	$session.^attributes.first(*.name eq '$!fh').get_value($session).close;

	throws-like { $session.append-message(msg('assistant', 'never')) },
		X::IO::Closed, 'the append fails rather than pretending';

	# The whole point of writing before committing: everything the session
	# reports is still exactly what is in the file.
	is $session.messages.elems, 1, 'the conversation did not grow';
	is $session.message-ids.elems, 1, 'nor did its ids';
	is $session.events.elems, 2, 'nor the envelope log';
	is $path.lines.elems, 2, 'and the file is what it always was';

	throws-like { $session.append-message(msg('assistant', 'nor this')) },
		X::IO::Closed, 'a second attempt fails the same way';
	is $session.messages.elems, 1, 'still without moving anything';

	$session.close;
};

subtest 'keys are serialised in a stable order' => {
	plan 2;

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});
	$session.append-message(msg('user', 'hello'));
	$session.close;

	# Sorted keys is what makes two transcripts of the same run diffable
	# — a plain Raku Hash iterates in a per-process random order.
	my $line = $path.lines.tail;
	ok $line.index('"id"') < $line.index('"payload"'),
		'id before payload';
	ok $line.index('"type"') < $line.index('"v"'),
		'type before v — the envelope is written in sorted key order';
};
