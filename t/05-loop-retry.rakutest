use Test;
use lib 'lib', 't/lib';
use AgentTestKit;
use LLM::Agent::Event;
use LLM::Agent::Loop;
use LLM::Agent::Session;
use LLM::Chat::Conversation::Message;

# Failure, bucket by bucket. Every subtest scripts one kind of failure and
# pins what the loop does about it — which backend it talks to next,
# whether it waits, what the AttemptFailed says, and what ends up in the
# conversation and the transcript.
#
# THE CLOCK IS NOT MOCKED, and does not need to be: `backoff-cap` is a
# real constructor option (it is the ceiling LLM::Chat::Retry's
# exponential is clamped to), so a test that wants the retry PATH without
# the retry WAIT sets it to a few milliseconds and reads the served
# backoff off the AttemptFailed event. That is the seam — proof by
# telemetry rather than by stopwatch.

plan 12;

# Small enough that a full retry ladder costs milliseconds, non-zero so
# `sleep-with-cancel` is really entered and the cancel check really runs.
my constant FAST-BACKOFF = 0.02;

my @prompt = [msg('user', 'hello'),];

my $tmp = $*TMPDIR.add("llm-agent-t05-{$*PID}-{now.Int}");
$tmp.mkdir;
END {
	close-test-sessions();
	if $tmp.e {
		.unlink for $tmp.dir;
		$tmp.rmdir;
	}
}

subtest 'a 5xx retries the same backend, waits, and then advances' => {
	plan 9;

	# max-retries counts ATTEMPTS on a backend, so 2 means one call and
	# one retry before the chain moves on. Two scripted 500s use both.
	my $first = scripted-backend(model => 'primary', steps => [
		{ error => 'upstream exploded', 'error-class' => 'http', 'error-status' => 500 },
		{ error => 'upstream exploded again', 'error-class' => 'http', 'error-status' => 500 },
	]);
	my $second = scripted-backend(model => 'fallback', steps => [
		{ content => 'the fallback answered' },
	]);

	my $loop = LLM::Agent::Loop.new(
		backends => [$first, $second], max-retries => 2,
	);
	my $run = $loop.run(@prompt);
	run-settled($run, 'the retrying run');
	my @events = drain-events($run);

	my @failed = events-of(@events, 'attempt-failed');
	is @failed.elems, 2, 'both attempts on the primary failed';

	is @failed[0].disposition, 'retry-same', 'the first says retry the same one';
	ok @failed[0].backoff >= 1, 'with a backoff of at least a second';
	is @failed[0].error-status, 500, 'and the status that put it in that bucket';
	is @failed[0].model, 'primary', 'named by the model that failed';

	is @failed[1].disposition, 'advance',
		'the second says advance — the retry budget is spent, and the '
			~ 'disposition reports what the loop DOES';
	nok @failed[1].backoff.defined, 'an advance does not wait';

	is $first.recorded-calls.elems, 2, 'exactly two attempts on the primary';
	is (await $run.result)<final>, 'the fallback answered',
		'and the fallback finished the job';
};

subtest 'a 429 advances at once rather than sitting out somebody else’s quota' => {
	plan 5;

	my $first = scripted-backend(steps => [
		{ error => 'rate limited', 'error-class' => 'http', 'error-status' => 429 },
	]);
	my $second = scripted-backend(steps => [{ content => 'answered' },]);

	my $loop = LLM::Agent::Loop.new(backends => [$first, $second]);
	my $run = $loop.run(@prompt);
	run-settled($run, 'the rate-limited run');
	my @events = drain-events($run);

	my @failed = events-of(@events, 'attempt-failed');
	is @failed.elems, 1, 'one failure, not a retry storm';
	is @failed[0].disposition, 'advance', 'the 429 advances';
	nok @failed[0].backoff.defined, 'without a wait';

	is $first.recorded-calls.elems, 1, 'the rate-limited backend was tried once';
	is events-of(@events, 'attempt-started')[1].backend-index, 1,
		'and the next attempt went to the next backend in the chain';
};

subtest 'a 4xx aborts the whole chain immediately' => {
	plan 6;

	my $first = scripted-backend(steps => [
		{ error => 'invalid api key', 'error-class' => 'http', 'error-status' => 401 },
	]);
	my $second = scripted-backend(steps => [{ content => 'never reached' },]);

	my $loop = LLM::Agent::Loop.new(backends => [$first, $second]);
	my $run = $loop.run(@prompt);
	run-settled($run, 'the aborting run');
	my @events = drain-events($run);

	is events-of(@events, 'attempt-failed').head.disposition, 'abort',
		'an authentication failure aborts';
	is $second.recorded-calls.elems, 0,
		'the rest of the chain is never tried — a bad key is bad everywhere';

	is event-kinds(@events).tail, 'run-failed', 'the run fails';
	my %outcome = await $run.result;
	is %outcome<outcome>, 'failed', 'and says so in the result';
	like %outcome<error>, /'invalid api key'/, 'carrying the reason';
	is %outcome<attempts>.elems, 1, 'with the one attempt that was made';
};

subtest 'a stalled stream is cancelled at the backend and classified as a timeout' => {
	plan 7;

	# `stall` emits its fragments and then goes silent for ever: no done,
	# no quit, and a last-activity-at that stops advancing. Nothing but an
	# inactivity timeout gets a run out of this.
	my $first = scripted-backend(steps => [
		{ chunks => ['thinking'], stall => True },
	]);
	my $second = scripted-backend(steps => [{ content => 'answered' },]);

	my $loop = LLM::Agent::Loop.new(
		backends => [$first, $second], round-trip-timeout => 0.3,
	);
	my $run = $loop.run(@prompt);
	run-settled($run, 'the stalled run');
	my @events = drain-events($run);

	is $first.cancelled-responses.elems, 1,
		'the loop cancelled the stalled response at its backend';

	my $failed = events-of(@events, 'attempt-failed').head;
	is $failed.error-class, 'timeout', 'and classified it as a timeout';
	is $failed.disposition, 'advance',
		'which is the advance bucket — the next backend answers sooner '
			~ 'than a backoff would end';
	like $failed.error, /'no activity'/,
		'the message says what actually happened';
	nok $failed.error-status.defined, 'and there is no HTTP status to report';

	is (await $run.result)<final>, 'answered', 'the run completed on the fallback';
	is events-of(@events, 'token').map({ .text }).join, 'thinkinganswered',
		'the tokens of the abandoned attempt were emitted and then framed '
			~ 'as failed — not silently dropped, and not retracted for you';
};

subtest 'a mid-stream failure retracts its tokens but never its transcript' => {
	plan 7;

	my $path = $tmp.add('midstream.jsonl');
	my $session = test-session(path => $path, meta => {});

	my $backend = scripted-backend(steps => [
		# Streams half a sentence, then the connection drops.
		{ chunks => ['Half a sen', 'tence that never arrives'],
		  'fail-after-chunks' => 1,
		  error => 'connection reset', 'error-class' => 'connection' },
		{ content => 'The whole answer.' },
	]);
	my $loop = LLM::Agent::Loop.new(
		backends => [$backend,], :$session, max-retries => 2,
	);

	my $run = $loop.run(@prompt);
	run-settled($run, 'the mid-stream failure');
	my @events = drain-events($run);

	my @kinds = event-kinds(@events);
	is @kinds.grep({ $_ eq 'attempt-started' }).elems, 2, 'two attempts';
	is events-of(@events, 'token').map({ .text }).join,
		'Half a senThe whole answer.',
		'every fragment that reached the wire was emitted, including the '
			~ 'ones the failed attempt streamed';

	# The framing is the contract: a consumer discards Tokens back to the
	# AttemptStarted that opened them.
	my $failed-at = @kinds.first({ $_ eq 'attempt-failed' }, :k);
	my $opened-at = @kinds[0 ..^ $failed-at].grep({ $_ eq 'attempt-started' }, :k).tail;
	is events-of(@events[$opened-at ..^ $failed-at], 'token').map({ .text }).join,
		'Half a sen',
		'and the retracted scope is exactly the failed attempt’s fragments';

	is events-of(@events, 'assistant-message').elems, 1,
		'only the successful attempt was committed';
	is events-of(@events, 'assistant-message').head.message.content,
		'The whole answer.',
		'with only the text the model really finished saying';

	$session.close;
	my $replayed = reopen-session(path => $path);
	is-deeply $replayed.messages.map({ .role ~ ':' ~ .content }).List,
		('user:hello', 'assistant:The whole answer.'),
		'and the transcript has no trace of the half sentence';
	is $replayed.events.grep({ $_<type> eq 'message' }).elems, 2,
		'two message lines, not three';
};

subtest 'exhausting every backend reports every attempt' => {
	plan 7;

	my $first = scripted-backend(model => 'a', steps => [
		{ chunks => ['partial'], 'fail-after-chunks' => 0,
		  error => 'network down', 'error-class' => 'connection' },
	]);
	my $second = scripted-backend(model => 'b', steps => [
		{ error => 'also down', 'error-class' => 'connection' },
	]);

	my $loop = LLM::Agent::Loop.new(
		backends => [$first, $second], max-retries => 1,
	);
	my $run = $loop.run(@prompt);
	run-settled($run, 'the exhausted run');

	my %outcome = await $run.result;
	is %outcome<outcome>, 'failed', 'the run failed';
	is %outcome<attempts>.elems, 2, 'one attempt recorded per backend';
	is %outcome<attempts>[0]<backend-index>, 0, 'in chain order';
	is %outcome<attempts>[0]<model>, 'a', 'naming the model that failed';
	like %outcome<attempts>[0]<error>, /'[backend 0]'/,
		'with the error prefixed by which backend it came from';
	nok %outcome<attempts>[1]<raw-text>:exists,
		'a failure that streamed nothing has NO raw-text key — an empty '
			~ 'one would look like a model that answered with nothing';
	like %outcome<error>, /'every backend failed'/, 'and a summary to match';
};

subtest 'a failure carrying text keeps it as raw-text' => {
	plan 2;

	my $backend = scripted-backend(steps => [
		{ chunks => ['most of an answer'], 'fail-after-chunks' => 1,
		  error => 'truncated', 'error-class' => 'response' },
	]);
	my $loop = LLM::Agent::Loop.new(backends => [$backend,], max-retries => 1);
	my $run = $loop.run(@prompt);
	run-settled($run, 'the truncated run');

	my %outcome = await $run.result;
	ok %outcome<attempts>[0]<raw-text>:exists,
		'what the model managed to say is kept';
	is %outcome<attempts>[0]<raw-text>, 'most of an answer', 'verbatim';
};

subtest 'an unclassifiable failure retries the same backend' => {
	plan 3;

	# No error-class at all: the conservative reading is a hiccup rather
	# than a permanent property of the model.
	my $backend = scripted-backend(steps => [
		{ error => 'something went wrong' },
		{ content => 'second time lucky' },
	]);
	my $loop = LLM::Agent::Loop.new(backends => [$backend,], max-retries => 2);
	my $run = $loop.run(@prompt);
	run-settled($run, 'the unclassified run');
	my @events = drain-events($run);

	is events-of(@events, 'attempt-failed').head.disposition, 'retry-same',
		'an error nobody has classified is retried';
	is events-of(@events, 'attempt-failed').head.error-class, 'unknown',
		'and reported with the class the backend did set';
	is (await $run.result)<final>, 'second time lucky', 'the retry worked';
};

# === Connect failures, and the chain with nowhere to advance to ============

subtest 'a flaky connection is ridden out on the only backend there is' => {
	plan 8;

	# THE REAL-WORLD SHAPE. One backend, and the first two attempts never
	# get a socket. Nothing about the endpoint is known — nothing was sent
	# and nothing was said — so the right move is to wait and ask again,
	# which is what 'connection' means.
	my $backend = scripted-backend(model => 'only', steps => [
		{ error => 'Exceeded timeout for connection when attempting to '
			~ 'access https://openrouter.ai/api/v1/chat/completions',
		  'error-class' => 'connection' },
		{ error => 'connection reset by peer', 'error-class' => 'connection' },
		{ content => 'third time lucky' },
	]);

	my $loop = LLM::Agent::Loop.new(
		backends => [$backend,], max-retries => 3,
		backoff-cap => FAST-BACKOFF,
	);
	my $run = $loop.run(@prompt);
	run-settled($run, 'the flaky-connection run');
	my @events = drain-events($run);

	is $backend.recorded-calls.elems, 3,
		'three attempts on the one backend, which is what max-retries buys';
	is events-of(@events, 'attempt-started').elems, 3,
		'and every one of them was framed as an attempt';

	my @failed = events-of(@events, 'attempt-failed');
	is @failed.elems, 2, 'the two that failed, and no more';
	is @failed.map({ .disposition }).unique.List, ('retry-same',),
		'both said retry the same backend';
	is @failed.map({ .error-class }).unique.List, ('connection',),
		'because a connect that never happened is a connection failure';

	# The BACKOFF is the assertion, not the wall clock: every wait was
	# really served through retry-backoff and really clamped to the cap
	# this loop was built with.
	ok @failed.all.backoff.defined, 'each retry waited';
	ok @failed.grep({ .backoff > 0 && .backoff <= FAST-BACKOFF }).elems == 2,
		'and waited exactly as long as backoff-cap allowed, which is how a '
			~ 'test drives the retry ladder without sitting out real seconds';

	is (await $run.result)<final>, 'third time lucky',
		'and the run that used to die on the first hiccup finished';
};

subtest 'an advance with nowhere to go waits and tries again instead' => {
	plan 6;

	# 'timeout' is the ADVANCE bucket — and on a one-backend chain there
	# is no next backend for it to advance to. Before this, the chain was
	# simply exhausted and the run died having made one call.
	my $backend = scripted-backend(model => 'only', steps => [
		{ error => 'the endpoint went quiet', 'error-class' => 'timeout' },
		{ content => 'and then it woke up' },
	]);

	my $loop = LLM::Agent::Loop.new(
		backends => [$backend,], max-retries => 2,
		backoff-cap => FAST-BACKOFF,
	);
	my $run = $loop.run(@prompt);
	run-settled($run, 'the sole-backend advance');
	my @events = drain-events($run);

	my @failed = events-of(@events, 'attempt-failed');
	is @failed.elems, 1, 'one failure';
	is @failed[0].disposition, 'retry-same',
		'reported as a retry, because that is what the loop DID with an '
			~ 'advance it had nowhere to take';
	is @failed[0].error-class, 'timeout',
		'without rewriting what the classifier actually said';
	ok @failed[0].backoff.defined, 'and it waited first';

	is $backend.recorded-calls.elems, 2, 'the backend was asked twice';
	is (await $run.result)<final>, 'and then it woke up', 'and it completed';
};

subtest 'an advance with a real next backend still advances at once' => {
	plan 8;

	# THE REGRESSION PIN, and the whole rule in one run: the FIRST backend
	# has somewhere to go, so its 429 advances immediately and without a
	# wait; the LAST one does not, so its 429 becomes a wait and one more
	# try; and when that budget is spent the chain ends exactly as before.
	my $first = scripted-backend(model => 'a', steps => [
		{ error => 'rate limited', 'error-class' => 'http', 'error-status' => 429 },
	]);
	my $second = scripted-backend(model => 'b', steps => [
		{ error => 'rate limited too', 'error-class' => 'http', 'error-status' => 429 },
		{ error => 'still rate limited', 'error-class' => 'http', 'error-status' => 429 },
	]);

	my $loop = LLM::Agent::Loop.new(
		backends => [$first, $second], max-retries => 2,
		backoff-cap => FAST-BACKOFF,
	);
	my $run = $loop.run(@prompt);
	run-settled($run, 'the two-backend advance');
	my @events = drain-events($run);

	is $first.recorded-calls.elems, 1,
		'the first backend was tried once and left behind — the next one in '
			~ 'the chain answers sooner than a backoff ends';
	is $second.recorded-calls.elems, 2,
		'and the last one spent its whole per-backend budget rather than '
			~ 'giving up with nowhere to advance to';

	my @failed = events-of(@events, 'attempt-failed');
	is @failed.elems, 3, 'three failures in all';
	is @failed[0].disposition, 'advance', 'the first advanced';
	nok @failed[0].backoff.defined, 'without waiting';
	is @failed[1].disposition, 'retry-same',
		'the last backend retried itself instead';
	is @failed[2].disposition, 'advance',
		'and when its budget ran out the chain ended, disposition and all';

	is (await $run.result)<outcome>, 'failed',
		'a chain that really is exhausted still fails the run';
};

subtest 'the two advances that must NOT become retries' => {
	plan 6;

	# --- abort is still abort, sole backend and all. --------------------
	my $bad-key = scripted-backend(model => 'only', steps => [
		{ error => 'invalid api key', 'error-class' => 'http',
		  'error-status' => 401 },
		{ content => 'never reached' },
	]);
	my $loop = LLM::Agent::Loop.new(
		backends => [$bad-key,], max-retries => 3, backoff-cap => FAST-BACKOFF,
	);
	my $run = $loop.run(@prompt);
	run-settled($run, 'the sole-backend abort');
	my @events = drain-events($run);

	is events-of(@events, 'attempt-failed').head.disposition, 'abort',
		'a 4xx aborts even when it is the only backend there is';
	is $bad-key.recorded-calls.elems, 1,
		'and is asked exactly once — a bad key will not heal in eight seconds';
	is (await $run.result)<outcome>, 'failed', 'the run fails';

	# --- and neither does a conversation that will not fit. -------------
	#
	# The context-overflow seatbelt turns a 400 into an advance. That one
	# is a DETERMINISTIC refusal of these exact bytes: re-sending them
	# buys an identical 400 and a wait on top of it, so it is the one
	# advance that keeps ending the backend's turn.
	my $too-big = scripted-backend(model => 'only', steps => [
		{ error => "This model's maximum context length is 8192 tokens",
		  'error-class' => 'http', 'error-status' => 400 },
		{ content => 'never reached' },
	]);
	my $strict = LLM::Agent::Loop.new(
		backends => [$too-big,], max-retries => 3, backoff-cap => FAST-BACKOFF,
	);
	my $run2 = $strict.run(@prompt);
	run-settled($run2, 'the oversized run');
	my @events2 = drain-events($run2);

	is $too-big.recorded-calls.elems, 1,
		'the same conversation is not sent to the same backend a second time';
	is events-of(@events2, 'attempt-failed').head.disposition, 'advance',
		'the seatbelt still reads it as an advance rather than an abort';
	is (await $run2.result)<outcome>, 'failed',
		'and with nowhere to advance to, the run ends';
};
