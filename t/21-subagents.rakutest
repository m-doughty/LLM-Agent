use Test;
use lib 'lib', 't/lib';
use JSON::Fast;
use AgentTestKit;
use LLM::Agent::Event;
use LLM::Agent::Loop;
use LLM::Agent::RequestBudget;
use LLM::Agent::Session;
use LLM::Agent::Subagents;
use LLM::Chat::Conversation::Message;

# Delegation: a provider that publishes a `task` tool, spawns a child run
# when the model calls it, forwards the child's events onto the PARENT's
# stream wrapped in Subagent events, and answers with what the child
# finally said.
#
# The three things this file exists to pin: the two streams never merge
# (the parent's terminal contract survives a child completing), a child
# that goes wrong is an is_error result and never an exception, and the
# guards refuse in words the model can act on rather than by throwing.

plan 28;

my $tmp = $*TMPDIR.add("llm-agent-t21-{$*PID}-{now.Int}");
$tmp.mkdir;
END {
	close-test-sessions();
	if $tmp.e {
		.unlink for $tmp.dir;
		$tmp.rmdir;
	}
}

my $n = 0;
sub fresh-path(--> IO::Path) { $tmp.add('s' ~ $n++ ~ '.jsonl') }

# Poll for a condition with a loud deadline. Never one sleep long enough
# to "probably" be right.
sub wait-until(&condition, Str:D $what) {
	my $deadline = now + TIMEOUT;
	until &condition() {
		die "Timed out after {TIMEOUT}s waiting for $what" if now > $deadline;
		sleep 0.005;
	}
}

sub read-tool(--> Hash) {
	tool-decl('fs_read', 'Read a file', { path => { type => 'string' } },
		required => ['path']);
}

sub types(--> List) {
	(
		{ name => 'reviewer', description => 'Reviews a diff and reports problems.' },
		{ name => 'tester', description => 'Runs the tests and reports failures.' },
	);
}

# A task call as the model would emit it.
sub task-call(
	Str:D $id, Str:D $type, Str:D $prompt, Str :$label, Str :$raw,
	--> Hash:D
) {
	tool-call($id, 'task', $raw // (
		'{"agent-type":"' ~ $type ~ '","prompt":"' ~ $prompt ~ '"'
			~ ($label.defined ?? ',"label":"' ~ $label ~ '"' !! '')
			~ '}'
	));
}

#|( The handle a spawn callback answers with: `.run` and `.session-path`,
    duck-typed, exactly as the composer checks for. )
class ChildHandle {
	has LLM::Agent::Run:D $.run is required;
	has Str:D $.session-path is required;
}

#|( A spawn callback over a table of scripts, keyed by agent type. Every
    child it starts is recorded in C<@children> — the run, the spec it was
    built from, and the loop that drives it (which has to be kept alive:
    a loop that goes out of scope takes nothing with it, but a test that
    wants to inspect one afterwards has to hold it). )
class Spawner {
	has %.scripts;
	has $.provider;
	has @.children;
	has Lock:D $!lock .= new;

	method callback(--> Callable:D) {
		-> %spec {
			my Str $type = %spec<type><name>;
			my $backend = scripted-backend(
				steps => (%!scripts{$type} // ()).map({ $_.Hash }).List,
			);
			my $loop = LLM::Agent::Loop.new(
				backends => [$backend,],
				|($!provider.defined ?? (provider => $!provider) !! ()),
			);
			my $run = $loop.run([msg('user', %spec<prompt>),]);

			$!lock.protect: {
				@!children.push: %(
					spec => %spec.Hash, :$run, :$loop, :$backend,
				);
			};

			ChildHandle.new(
				run => $run,
				session-path => $tmp.add("{%spec<agent-id>}.jsonl").Str,
			);
		};
	}

	method runs(--> List) { $!lock.protect: { @!children.map({ $_<run> }).List } }
	method specs(--> List) { $!lock.protect: { @!children.map({ $_<spec> }).List } }
	method count(--> Int) { $!lock.protect: { @!children.elems } }
}

# The two-round child script every happy-path test uses: a tool round,
# then an answer.
sub review-script(Str:D $answer = 'the review: it is fine' --> List) {
	(
		{ content => 'looking', tool-calls => [tool-call('k1', 'fs_read', '{"path":"a"}'),] },
		{ content => $answer },
	);
}

sub child-provider(--> ScriptedProvider) {
	ScriptedProvider.new(
		tools => [read-tool(),], results => { fs_read => 'the file says hello' },
	);
}

subtest 'the task tool is published beside the inner catalogue' => {
	plan 8;

	my $inner = ScriptedProvider.new(tools => [read-tool(),]);
	my $subagents = LLM::Agent::Subagents.new(
		inner => $inner, types => types(), spawn => -> %spec { Nil },
	);

	my @tools = $subagents.tools-for-llm.list;
	is @tools.map({ $_<function><name> }).List,
		('fs_read', 'task', 'task_answer', 'task_wait'),
		"the inner catalogue first, in its own order, and the composer's "
			~ 'own three tools last — the delegation protocol is published '
			~ 'whole, because a catalogue is fixed for a whole turn and the '
			~ 'way to answer a question has to be there before one is asked';
	is-deeply @tools[0], read-tool(),
		'an inner declaration is passed through byte for byte — a composer '
			~ 'that rewrote them would change what the model may call';

	my %task = @tools[1]<function>;
	is %task<parameters><required>.List, ('agent-type', 'prompt'),
		'agent-type and prompt are required; label is not';
	is %task<parameters><properties><agent-type><enum>.List,
		('reviewer', 'tester'),
		'and agent-type is an enum of exactly the types it was built with';
	ok %task<description>.contains('reviewer: Reviews a diff'),
		'the description tells the model what each agent is for, because '
			~ 'nothing else will';
	ok %task<parameters><properties><prompt><description>.contains('nothing of this one'),
		'and that the child sees nothing of this conversation';

	is $subagents.type-names.List, ('reviewer', 'tester'), 'type-names';
	is $subagents.types[0]<description>, 'Reviews a diff and reports problems.',
		'and types answers with the table it was given';
};

subtest 'an inner tool called task is dropped rather than published twice' => {
	plan 2;

	# Two declarations under one name is a request several providers
	# reject outright, and the composer owns the names it routes on — all
	# three of them.
	my $inner = ScriptedProvider.new(
		tools => [
			read-tool(),
			tool-decl('task', 'Something else entirely'),
			tool-decl('task_wait', 'And something else again'),
		],
	);
	my $subagents = LLM::Agent::Subagents.new(
		inner => $inner, types => types(), spawn => -> %spec { Nil },
	);

	my @names = $subagents.tools-for-llm.map({ $_<function><name> }).List;
	is @names, ('fs_read', 'task', 'task_answer', 'task_wait'),
		'each name appears exactly once';
	ok $subagents.tools-for-llm[1]<function><description>.starts-with('Delegate')
		&& $subagents.tools-for-llm[3]<function><description>.starts-with('Wait for'),
		"and they are the composer's, not the inner provider's";
};

subtest 'a task call runs a child and answers with its final text' => {
	plan 9;

	my $spawner = Spawner.new(
		scripts => { reviewer => review-script() }, provider => child-provider(),
	);
	my $inner = ScriptedProvider.new(
		tools => [read-tool(),], results => { fs_read => 'parent read' },
	);

	my $loop;
	my $subagents = LLM::Agent::Subagents.new(
		inner => $inner, types => types(), spawn => $spawner.callback,
		# The deferred form: $loop does not exist yet, and `loop => $loop`
		# would copy an undefined value for ever.
		loop => { $loop },
	);

	my $backend = scripted-backend(steps => [
		{ content => 'delegating',
		  tool-calls => [task-call('c1', 'reviewer', 'review the diff', label => 'diff review'),] },
		{ content => 'the reviewer says it is fine' },
	]);
	$loop = LLM::Agent::Loop.new(backends => [$backend,], provider => $subagents);

	my $run = $loop.run([msg('user', 'review this'),]);
	run-settled($run, 'the delegating run');
	my @events = drain-events($run);

	is (await $run.result)<outcome>, 'completed', 'the parent run completed';
	is events-of(@events, 'tool-result').head.content,
		'the review: it is fine',
		"and the tool result IS the child's final message";
	nok events-of(@events, 'tool-result').head.is-error,
		'not an error';

	is $spawner.count, 1, 'exactly one child was spawned';
	is-deeply $spawner.specs[0]<type>, types()[0].Hash,
		'and the spawn callback was handed the type record verbatim, so an '
			~ "app's own keys survive";
	is $spawner.specs[0]<prompt>, 'review the diff', 'with the prompt';
	is $spawner.specs[0]<label>, 'diff review', 'and the label';

	# THE ORDERING PROPERTY: the child's events land between the tool
	# starting and the tool answering, in the child's own order, on the
	# parent's stream.
	my @kinds = event-kinds(@events);
	my $started = @kinds.first({ $_ eq 'tool-started' }, :k);
	my $result = @kinds.first({ $_ eq 'tool-result' }, :k);
	my @wrapped = @events.grep({ $_ ~~ LLM::Agent::Event::Subagent }).List;
	my @between = @wrapped.map({ $_.seq }).grep({ $started < $_ < $result });
	ok @wrapped.elems > 5 && @between.elems == @wrapped.elems,
		"every one of the child's events arrives after the call started "
			~ 'and before it answered';

	is-deeply @wrapped.map({ $_.inner<seq> }).List,
		(^@wrapped.elems).List,
		"and they arrive in the child's own order, contiguously, with the "
			~ "child's seq intact inside the parent's";
};

subtest 'the wrapping keeps the two envelopes apart' => {
	plan 9;

	my $spawner = Spawner.new(
		scripts => { tester => (({ content => 'all green' },)) },
	);
	my $loop;
	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]),
		types => types(), spawn => $spawner.callback, loop => { $loop },
	);

	my $backend = scripted-backend(steps => [
		{ content => 'delegating',
		  tool-calls => [task-call('c1', 'tester', 'run the tests'),] },
		{ content => 'green' },
	]);
	$loop = LLM::Agent::Loop.new(backends => [$backend,], provider => $subagents);

	my $run = $loop.run([msg('user', 'test this'),]);
	run-settled($run, 'the tester run');
	my @events = drain-events($run);

	my @wrapped = @events.grep({ $_ ~~ LLM::Agent::Event::Subagent });
	is @wrapped.map({ $_.run-id }).unique.List, ($run.id,),
		"every wrapper carries the PARENT's run-id";
	isnt @wrapped[0].inner<run-id>, $run.id,
		"and the inner event the CHILD's";
	is @wrapped[0].inner<run-id>, $spawner.runs[0].id,
		'which is the child run it came from';

	is @wrapped.map({ $_.agent-id }).unique.List, ('tester-1',),
		'all of them tagged with the agent id';
	is @wrapped.map({ $_.agent-type }).unique.List, ('tester',),
		'and the agent type';

	# THE JOIN, and it is constant for the child's whole life: every
	# wrapper names the `task` call that started it, which is the only
	# thing tying the tool-call events for that call to the child events
	# it produced.
	is @wrapped.map({ $_.call-id }).unique.List, ('c1',),
		'every wrapper names the task call the child was started by';
	is @wrapped[0].to-hash<call-id>, 'c1',
		'and it is in the flattened form a transcript stores';

	my @terminal = @wrapped.grep({
		LLM::Agent::Event::TERMINAL-KINDS{$_.inner<kind>};
	});
	is @terminal.elems, 1,
		"the child's terminal event is forwarded like any other";
	nok @terminal[0].is-terminal,
		'and the wrapper around it is NOT terminal — the child ending is '
			~ 'not the parent ending, and a consumer that stops on a '
			~ 'terminal must not stop here';
};

subtest 'a child that fails becomes an is_error result, and the run goes on' => {
	plan 5;

	my $spawner = Spawner.new(scripts => {
		reviewer => (({ error => 'the model is on fire', error-class => 'http',
			error-status => 500 },)),
	});
	my $loop;
	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]),
		types => types(), spawn => $spawner.callback, loop => { $loop },
	);

	my $backend = scripted-backend(steps => [
		{ content => 'delegating',
		  tool-calls => [task-call('c1', 'reviewer', 'review the diff'),] },
		{ content => 'the reviewer could not do it, so here is my own answer' },
	]);
	$loop = LLM::Agent::Loop.new(backends => [$backend,], provider => $subagents);

	my $run = $loop.run([msg('user', 'review this'),]);
	run-settled($run, 'the failing-child run');
	my @events = drain-events($run);

	is (await $run.result)<outcome>, 'completed',
		"the PARENT completed: a child's failure is data, not an exception";
	my $result = events-of(@events, 'tool-result').head;
	ok $result.is-error, 'the task call came back as an error';
	ok $result.content.contains('reviewer-1'),
		'naming the agent that failed';
	ok $result.content.contains('the model is on fire'),
		'and saying why, in the words the child failed with';
	# Released when the child DRAINED, which for a child that failed
	# outright is a moment after its result — so this is polled rather
	# than read once, and the poll is the assertion.
	wait-until({ $subagents.live-agents.elems == 0 }, 'the slot to be freed');
	is $subagents.live-agents.elems, 0,
		'and its slot was released once the child stopped producing';
};

subtest 'the arguments a model gets wrong are refused in words' => {
	plan 7;

	my $spawner = Spawner.new(scripts => { reviewer => review-script() });
	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]),
		types => types(), spawn => $spawner.callback,
	);

	# No loop, no run: a task call is answerable on its own, which is what
	# makes the refusals testable without driving a whole loop.
	sub refusal(Str:D $arguments --> Hash) {
		$subagents.execute-tool-calls(
			[tool-call('c1', 'task', $arguments),],
		).head;
	}

	my %unknown = refusal('{"agent-type":"designer","prompt":"do it"}');
	ok %unknown<is_error>, 'an agent type nobody registered is refused';
	ok %unknown<content>.contains("'reviewer', 'tester'"),
		'and the refusal lists the ones that exist';

	ok refusal('{"prompt":"do it"}')<is_error>, 'a call with no agent-type';
	ok refusal('{"agent-type":"reviewer"}')<is_error>, 'a call with no prompt';
	ok refusal('{"agent-type":"reviewer","prompt":"   "}')<is_error>,
		'a call whose prompt is only whitespace';
	ok refusal('not json at all')<is_error>,
		'and arguments that are not a JSON object at all';

	is $spawner.count, 0,
		'and not one of them started a child: a refusal is a refusal '
			~ 'before anything has been spent';
};

subtest 'the identical-spawn guard trips at the cap' => {
	plan 5;

	my $spawner = Spawner.new(scripts => {
		reviewer => (({ content => 'the same answer' },)),
	});
	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]),
		types => types(), spawn => $spawner.callback,
		max-identical-spawns => 2,
	);

	my Int $call-number = 0;
	sub spawn-once(Str:D $arguments --> Hash) {
		$subagents.execute-tool-calls(
			[tool-call('c' ~ $call-number++, 'task', $arguments),],
		).head;
	}

	my $first = '{"agent-type":"reviewer","prompt":"review the diff"}';
	nok spawn-once($first)<is_error>, 'the first spawn runs';
	# The same request, written differently: key order and the JSON's own
	# whitespace are not part of what makes two spawns identical, exactly
	# as they are not for the loop's identical-call guard.
	nok spawn-once('{ "prompt" : "review the diff", "agent-type" : "reviewer" }')<is_error>,
		'the second, written with the keys the other way round, still runs';

	my %third = spawn-once($first);
	ok %third<is_error>,
		'the third is refused: the same task twice over is an answer '
			~ 'already given';
	ok %third<content>.contains('2 times'),
		'and the refusal says what the limit was';

	nok spawn-once('{"agent-type":"reviewer","prompt":"review something else"}')<is_error>,
		'while a different task is unaffected — the guard is per request, '
			~ 'not per agent';
};

subtest 'the identical-spawn tally is per run unless the host says otherwise' => {
	plan 4;

	# Three identical delegations inside one run are a model going round
	# in circles. Three across three runs are three occasions on which
	# somebody asked for the same thing — and a composer that refused the
	# fourth because of what happened an hour ago gets more broken the
	# longer the host stays up.
	sub across-two-runs(Str:D $scope --> List) {
		my $gate-a = Promise.new;
		my $gate-b = Promise.new;
		my $inner = ScriptedProvider.new(
			tools => [read-tool(),], results => { fs_read => 'held' },
			block-call => { h1 => $gate-a, h2 => $gate-b },
		);

		my $loop;
		my $subagents = LLM::Agent::Subagents.new(
			inner => $inner, types => types(), loop => { $loop },
			max-identical-spawns => 2, identical-spawn-scope => $scope,
			spawn => -> %spec {
				ChildHandle.new(
					run => LLM::Agent::Loop.new(
						backends => [scripted-backend(
							steps => [{ content => 'done' },],
						),],
					).run([msg('user', %spec<prompt>),]),
					session-path => '',
				);
			},
		);

		# Each run is held open by a blocked tool call of its own, so the
		# task calls below are dispatched into a run that is demonstrably
		# live rather than one this test hopes is.
		my $backend = scripted-backend(steps => [
			{ content => 'A holds', tool-calls => [tool-call('h1', 'fs_read', '{}'),] },
			{ content => 'A done' },
			{ content => 'B holds', tool-calls => [tool-call('h2', 'fs_read', '{}'),] },
			{ content => 'B done' },
		]);
		$loop = LLM::Agent::Loop.new(backends => [$backend,], provider => $subagents);

		my Str $same = '{"agent-type":"reviewer","prompt":"the same task"}';

		my $run-a = $loop.run([msg('user', 'A'),]);
		wait-until({ $inner.recorded-calls.elems == 1 }, "run A to park ($scope)");
		my @in-a = (^3).map(-> $i {
			?$subagents.execute-tool-calls(
				[tool-call("a$i", 'task', $same),],
			).head<is_error>;
		}).List;
		$gate-a.keep(True);
		run-settled($run-a, "run A ($scope)");

		my $run-b = $loop.run([msg('user', 'B'),]);
		wait-until({ $inner.recorded-calls.elems == 2 }, "run B to park ($scope)");
		my Bool $in-b = ?$subagents.execute-tool-calls(
			[tool-call('b1', 'task', $same),],
		).head<is_error>;
		$gate-b.keep(True);
		run-settled($run-b, "run B ($scope)");

		(|@in-a, $in-b);
	}

	my @per-run = across-two-runs('run');
	is @per-run[0 .. 2].List, (False, False, True),
		'inside one run the cap holds: two go, the third is refused';
	nok @per-run[3],
		'and the next RUN starts with a clean tally — the same question '
			~ 'asked again is a new question';

	my @per-composer = across-two-runs('composer');
	ok @per-composer[2],
		"with identical-spawn-scope => 'composer' the cap holds the same "
			~ 'way inside a run';
	ok @per-composer[3],
		'and goes on holding across runs, which is what that scope is for';
};

subtest 'the max-live backstop refuses while children are running' => {
	plan 5;

	my $gate = Promise.new;
	# A child whose one tool call is blocked, so it stays live until the
	# test lets it go.
	my $blocked = ScriptedProvider.new(
		tools => [read-tool(),], results => { fs_read => 'eventually' },
		block-call => { fs_read => $gate },
	);
	my $spawner = Spawner.new(
		scripts => { reviewer => review-script() }, provider => $blocked,
	);
	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]),
		types => types(), spawn => $spawner.callback, max-live => 2,
	);

	my @in-flight = (^2).map(-> $i {
		start $subagents.execute-tool-calls(
			[task-call("c$i", 'reviewer', "review chunk $i"),],
		).head;
	});
	# Both conditions, because a slot appears the moment a spawn is
	# ADMITTED and the handle's session-path is written when the callback
	# answers: waiting on the count alone can read a row that is still
	# `starting`, whose path is the empty string it was reserved with.
	wait-until(
		{
			my @live = $subagents.live-agents;
			@live.elems == 2 && !@live.grep({ $_<starting> }).elems;
		},
		'both children to start and register',
	);

	is $subagents.live-agents.map({ $_<agent-id> }).List,
		('reviewer-1', 'reviewer-2'),
		'live-agents lists them, oldest first';
	ok $subagents.live-agents[0]<session-path>.ends-with('reviewer-1.jsonl'),
		"each carrying the path the spawn callback gave it";

	my %refused = $subagents.execute-tool-calls(
		[task-call('c9', 'reviewer', 'review one more chunk'),],
	).head;
	ok %refused<is_error>, 'a third is refused while two are running';
	ok %refused<content>.contains('Wait for'),
		'and told to wait rather than left to guess';

	$gate.keep(True);
	my @results = await @in-flight;
	is @results.grep({ !$_<is_error> }).elems, 2,
		'and once they answer, both of the running ones succeeded';
};

subtest 'cancelling the parent cancels its children' => {
	plan 5;

	my $gate = Promise.new;
	my $blocked = ScriptedProvider.new(
		tools => [read-tool(),], results => { fs_read => 'eventually' },
		block-call => { fs_read => $gate },
	);
	my $spawner = Spawner.new(
		scripts => { reviewer => review-script() }, provider => $blocked,
	);

	my $path = fresh-path();
	my $session = test-session(path => $path, meta => {});

	my $loop;
	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]),
		types => types(), spawn => $spawner.callback, loop => { $loop },
		:$session,
	);

	my $backend = scripted-backend(steps => [
		{ content => 'delegating',
		  tool-calls => [task-call('c1', 'reviewer', 'review the diff'),] },
		{ content => 'never reached' },
	]);
	$loop = LLM::Agent::Loop.new(
		backends => [$backend,], provider => $subagents, :$session,
	);

	my $run = $loop.run([msg('user', 'review this'),]);
	# The slot, which is taken BEFORE the spawn callback is called — so
	# this deliberately cancels at whichever point the runner happens to
	# have reached, including the window where the child run does not
	# exist yet. Every one of them has to end the same way.
	wait-until({ $subagents.live-agents.elems == 1 }, 'the child to be admitted');

	$run.cancel;
	run-settled($run, 'the cancelled parent');

	# Only now is there a child run to read: the spawner records inside
	# the callback, which the cancel above may well have interrupted.
	wait-until({ $spawner.count == 1 }, 'the child run to be built');
	my $child = $spawner.runs[0];
	wait-until({ $child.is-done }, 'the child to notice');
	is $child.result.result<outcome>, 'cancelled',
		'the cascade reached the child: cancelling the parent cancelled it';
	is (await $run.result)<outcome>, 'cancelled', 'and the parent is cancelled';

	# The task call still settled — the batch was detached, not left
	# hanging — and the transcript is where that is visible.
	wait-until(
		{ $session.events.grep({ $_<type> eq 'subagent-settled' }).elems == 1 },
		'the settle envelope',
	);
	my %settled = $session.events.first({ $_<type> eq 'subagent-settled' })<payload>;
	is %settled<outcome>, 'cancelled', 'and recorded as cancelled';
	ok %settled<result>.contains('cancelled'),
		'with a result that says so in the words the model would have been '
			~ 'given';

	# The slot outlives the answer by however long the child takes to
	# stop producing — which here depends on whether the cancel beat the
	# child to its tool call, so the deterministic half of that property
	# is pinned by the "owned until it has DRAINED" subtest instead. What
	# is unconditional is that it IS released, once the child is quiet.
	$gate.keep(True);
	wait-until({ $subagents.live-agents.elems == 0 },
		'the child to drain once its tool call comes back');
	is $subagents.live-agents.elems, 0, 'and only then is it let go';

	$session.close;
};

subtest 'a cancel arriving inside the spawn window still settles the call' => {
	plan 6;

	# THE WINDOW: a spawn has taken its slot and the child run does not
	# exist yet, because building one is the app's code and can take as
	# long as it likes. This subtest parks the spawn callback exactly
	# there and cancels the parent while it is parked, so the interleaving
	# is a fact rather than something a slow runner might hit.
	#
	# Both calls of the batch are in the window, because a batch of task
	# calls is started all at once (see "Several task calls at once") —
	# which is why the cancel here has to reach TWO parked spawns and not
	# one parked spawn and one that never began.
	#
	# That is also why the FIRST interception point — the pre-spawn check
	# that refuses before the callback is entered at all — is no longer
	# something this file can force: it needs the cancel to land between a
	# call's admission and its own check, and with every call of a batch
	# admitted and entered at once that window is a scheduling accident
	# rather than a state a test can construct. It is still the arm that
	# fires when the cancel wins that race, and what this subtest pins is
	# the property both arms share and the one that matters: every call
	# settles, and no child is left running behind a call nobody is
	# waiting for.
	my $in-spawn = Promise.new;
	my $release = Promise.new;
	my $lock = Lock.new;
	my Int $spawns = 0;
	my @built;

	# The children's own tool call never answers, so a child that is NOT
	# cancelled would run for ever — which is what a hung task call looked
	# like on CI, and what this must not do.
	my $never = Promise.new;
	my $child-tools = ScriptedProvider.new(
		tools => [read-tool(),], results => { fs_read => 'never' },
		block-call => { fs_read => $never },
	);

	my &spawn = -> %spec {
		# The count and the latch under ONE lock: both calls of the batch
		# arrive here at once now, and a bare `keep if Planned` is a race
		# two threads lose together — the second `keep` throws, which the
		# composer would quite correctly report as a spawn that failed.
		$lock.protect: {
			$spawns++;
			$in-spawn.keep(True) if $in-spawn.status ~~ Planned;
		};
		await $release;

		my $loop = LLM::Agent::Loop.new(
			backends => [scripted-backend(steps => review-script()),],
			provider => $child-tools,
		);
		my $run = $loop.run([msg('user', %spec<prompt>),]);
		$lock.protect: { @built.push: %( :$run, :$loop ) };
		ChildHandle.new(run => $run, session-path => '');
	};

	# A parent run held open by a blocked tool call of its own, so that
	# "there is a live run when the batch is dispatched" is also a fact.
	my $parent-gate = Promise.new;
	my $parent-tools = ScriptedProvider.new(
		tools => [read-tool(),], results => { fs_read => 'held' },
		block-call => { fs_read => $parent-gate },
	);

	my $loop;
	my $subagents = LLM::Agent::Subagents.new(
		inner => $parent-tools, types => types(), :&spawn, loop => { $loop },
	);
	my $backend = scripted-backend(steps => [
		{ content => 'holding', tool-calls => [tool-call('h1', 'fs_read', '{}'),] },
		{ content => 'never reached' },
	]);
	$loop = LLM::Agent::Loop.new(backends => [$backend,], provider => $subagents);

	my $run = $loop.run([msg('user', 'hold the run open'),]);
	wait-until({ $parent-tools.recorded-calls.elems == 1 },
		'the parent to park in a tool call');

	# Two task calls in ONE batch — dispatched here rather than by the
	# loop, which only groups them when the app has said `task` may be
	# grouped. Both park in the window.
	my $batch = start $subagents.execute-tool-calls([
		task-call('t1', 'reviewer', 'review one'),
		task-call('t2', 'reviewer', 'review two'),
	]);

	await Promise.anyof($in-spawn, Promise.in(TIMEOUT));
	is $in-spawn.status, Kept, 'a spawn is parked inside the window';
	wait-until({ $subagents.live-agents.elems == 2 },
		'both spawns to take their slots');
	is $subagents.live-agents.elems, 2, 'both slots are taken';
	is $subagents.live-agents.grep({ $_<starting> }).elems, 2,
		'and both are cancellation targets with no run behind them yet';

	# HERE. Nothing exists that a Run-shaped sweep of the table could find.
	$run.cancel;
	$release.keep(True);

	await Promise.anyof($batch, Promise.in(TIMEOUT));
	is $batch.status, Kept,
		'the batch settles: a cancel in the window does not strand it';

	my @answers = $batch.result.List;
	is @answers.grep({
		$_<is_error> && $_<content>.contains('cancelled');
	}).elems, 2,
		'both calls that were in the window are answered as cancelled';

	wait-until({ @built.elems == $spawns && @built.all<run>.map({ .is-done }).all.so },
		'the children that were started');
	is @built.grep({ $_<run>.result.result<outcome> ne 'cancelled' }).elems, 0,
		'and every child that HAD been built was cancelled rather than left '
			~ 'running behind a call nobody was waiting for';

	$parent-gate.keep(True);
	$never.keep(True);
	drained-settled($run, 'the cancelled parent');
};

subtest 'a child is owned until it has DRAINED, not until it has answered' => {
	plan 17;

	# The gap this subtest exists for: a child that abandoned a tool call
	# to a deadline has a result — the parent gets its answer, which is
	# right — while the detached call is still running somewhere. Letting
	# go of the child there would free its max-live slot, drop it out of
	# live-agents, and leave cancel-children with nothing to cancel while
	# a tool call carries on writing files.
	#
	# And the other half of it: OWNED is not LIVE. A child that never
	# drains is owned for ever, and a composer that counted it against
	# max-live would spend the rest of the host's life refusing work on
	# behalf of something that has stopped doing any.
	my $never = Promise.new;
	my $stuck = ScriptedProvider.new(
		tools => [read-tool(),], results => { fs_read => 'far too late' },
		block-call => { fs_read => $never },
	);

	# The second child's tools: gated while the test needs it live, and
	# then an ordinary tool round it finishes and drains from.
	my $gate2 = Promise.new;
	my $working = ScriptedProvider.new(
		tools => [read-tool(),], results => { fs_read => 'the file says hello' },
		block-call => { fs_read => $gate2 },
	);

	my @kids;
	my $lock = Lock.new;
	# Two children out of one callback, told apart by the prompt they were
	# given: the first wedges for ever, the second is the one admitted
	# beside it.
	my &spawn = -> %spec {
		my $loop = %spec<prompt> eq 'do the thing'
			?? LLM::Agent::Loop.new(
				backends => [scripted-backend(steps => [
					{ content => 'starting',
					  tool-calls => [tool-call('k1', 'fs_read', '{"path":"a"}'),] },
					{ content => 'I gave up on the tool and answered anyway' },
				]),],
				provider => $stuck,
				# Short, and against a call that never answers: the child
				# WILL reach its deadline, so nothing here waits on a
				# clock to be lucky.
				tool-deadline => 0.15,
			)
			!! LLM::Agent::Loop.new(
				backends => [scripted-backend(steps => [
					{ content => 'working',
					  tool-calls => [tool-call('k2', 'fs_read', '{"path":"b"}'),] },
					{ content => 'second done' },
				]),],
				# No tool-deadline: this one is held open by the gate and
				# then answers properly, which is what makes it the LIVE
				# child rather than a second wedge.
				provider => $working,
			);
		my $run = $loop.run([msg('user', %spec<prompt>),]);
		$lock.protect: { @kids.push: %( :$run, :$loop ) };
		ChildHandle.new(run => $run, session-path => '');
	};

	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]),
		types => types(), :&spawn, max-live => 1, drain-grace => 0.05,
	);

	my %answer = $subagents.execute-tool-calls(
		[task-call('c1', 'reviewer', 'do the thing'),],
	).head;

	nok %answer<is_error>, 'the parent gets its answer as soon as the child '
		~ 'has one — a detached tool call is not a reason to make a model wait';
	is %answer<content>, 'I gave up on the tool and answered anyway',
		'and it is what the child said';

	my $child = $lock.protect: { @kids[0]<run> };
	is $child.result.status, Kept, 'the child has a result';
	is $child.drained.status, Planned,
		'and has NOT drained: its abandoned tool call is still running';

	is $subagents.live-agents.elems, 1,
		'so the composer still owns it — the slot is not free yet';
	ok $subagents.live-agents[0]<draining>,
		'and says which of the two it is';
	wait-until({ ?$subagents.live-agents[0]<wedged> }, 'the drain grace to expire');
	ok $subagents.live-agents[0]<wedged>,
		'then exposes the wedge without reclaiming its slot or ownership';

	is $subagents.owned-count, 1,
		'owned, still: a wedge is this composer\'s to cancel until it drains';
	is $subagents.live-count, 0,
		'and live: nothing here can answer any more. That split is what the '
			~ 'admission check turns on';

	# ADMITTED, at max-live 1, beside a child the composer still owns.
	my $second = start $subagents.execute-tool-calls(
		[task-call('c2', 'reviewer', 'do the second thing'),],
	).head;
	wait-until({ $subagents.live-agents.elems == 2 },
		'a second child to be admitted beside the wedge');
	is $subagents.owned-count, 2, 'two children owned';
	is $subagents.live-count, 1,
		'one of which can answer — the wedge is not holding a slot';

	# And the slot the live one took is a real one: while it is still
	# working, a third call is refused.
	my %refused = $subagents.execute-tool-calls(
		[task-call('c3', 'reviewer', 'do a third thing'),],
	).head;
	ok %refused<is_error>,
		'a third IS refused while the live one runs — the backstop still '
			~ 'holds, it is only counting something else';
	ok %refused<content>.contains('already 1')
		&& %refused<content>.contains('the limit (1)'),
		'and it refuses in the live count\'s words: a model told "there are '
			~ 'already 2" would be waiting for one that is never coming';

	$gate2.keep(True);
	my %second-answer = await $second;
	is %second-answer<content>, 'second done',
		'the live child answers normally';
	wait-until({ $subagents.owned-count == 1 },
		'the second child to drain and let go of its slot');
	is $subagents.live-count, 0,
		'and once it has drained only the wedge is left — owned, uncounted';

	is $subagents.cancel-children, 1,
		'a shutdown reaches it, which is the whole point of holding on';

	# And only now, when the detached call finally comes back.
	$never.keep(True);
	wait-until({ $subagents.live-agents.elems == 0 },
		'the child to drain and free its slot');
	is $subagents.live-agents.elems, 0, 'the slot frees on drained';
};

subtest 'a child that outlives its run never publishes into the next one' => {
	plan 8;

	# PROVENANCE. The child is a hand-driven Run — the driving seam
	# LLM::Agent::Run documents — so this test decides exactly when it
	# emits, which is what makes "after its parent ended, while the NEXT
	# run is live" a fact rather than a hope about scheduling.
	my $child = LLM::Agent::Run.new(id => 'child-run');
	my &spawn = -> %spec { ChildHandle.new(run => $child, session-path => '') };

	# Both parent runs are held open by a blocked tool call of their own,
	# so "A is live" and "B is live" are things this test can wait for.
	my $gate-a = Promise.new;
	my $gate-b = Promise.new;
	my $inner = ScriptedProvider.new(
		tools => [read-tool(),], results => { fs_read => 'held' },
		block-call => { h1 => $gate-a, h2 => $gate-b },
	);

	my $loop;
	my $subagents = LLM::Agent::Subagents.new(
		inner => $inner, types => types(), :&spawn, loop => { $loop },
	);
	# One script, consumed across both runs in order. A is cancelled while
	# its tool call is blocked, so it takes exactly one step and never
	# comes back for a second round; the two after it are B's.
	my $backend = scripted-backend(steps => [
		{ content => 'A holds', tool-calls => [tool-call('h1', 'fs_read', '{}'),] },
		{ content => 'B holds', tool-calls => [tool-call('h2', 'fs_read', '{}'),] },
		{ content => 'B is done' },
	]);
	$loop = LLM::Agent::Loop.new(backends => [$backend,], provider => $subagents);

	# --- run A, and a task call inside it. ---------------------------
	my $run-a = $loop.run([msg('user', 'first'),]);
	wait-until({ $inner.recorded-calls.elems == 1 }, 'A to park');

	my $task = start $subagents.execute-tool-calls(
		[task-call('t1', 'reviewer', 'outlive me'),],
	);
	wait-until({ $subagents.live-agents.elems == 1 }, 'the child to be owned');

	$child._emit(LLM::Agent::Event::Token.new(text => 'while A is live'));

	# --- A ends; B starts. -------------------------------------------
	$run-a.cancel;
	$gate-a.keep(True);
	run-settled($run-a, 'run A');
	my @a-events = drain-events($run-a);

	my $run-b = $loop.run([msg('user', 'second'),]);
	wait-until({ $inner.recorded-calls.elems == 2 }, 'B to park');
	is $loop.live-run.id, $run-b.id, 'the loop is now driving a DIFFERENT run';

	# THE EVENT THAT MUST NOT LAND ON B. A lookup-at-fire-time forwarder
	# publishes it there; a run-bound one drops it.
	$child._emit(LLM::Agent::Event::Token.new(text => 'after A ended'));
	$child._finish(
		LLM::Agent::Event::RunCancelled.new(stage => 'tools'),
		final => '', messages => (),
	);

	await Promise.anyof($task, Promise.in(TIMEOUT));
	is $task.status, Kept, "A's task call settled rather than hanging";
	ok $task.result.head<is_error>,
		'as an error: the child it was waiting for was cancelled';

	$gate-b.keep(True);
	run-settled($run-b, 'run B');
	my @b-events = drain-events($run-b);

	my @on-a = @a-events.grep({ $_ ~~ LLM::Agent::Event::Subagent }).List;
	my @on-b = @b-events.grep({ $_ ~~ LLM::Agent::Event::Subagent }).List;

	is @on-a.elems, 1, 'A carries the event its child emitted while A was live';
	is @on-a[0].inner<text>, 'while A is live', 'and it is the right one';
	is @on-a.map({ $_.run-id }).unique.List, ($run-a.id,),
		"stamped with A's envelope";
	is @on-b.elems, 0,
		"and B carries NOTHING of A's child: not the event it emitted while "
			~ 'B was live, and not its terminal either';
	is (await $run-b.result)<outcome>, 'completed',
		'B is unaffected in every other way';
};

subtest 'cancel-children settles a task call as an error instead of hanging' => {
	plan 3;

	my $gate = Promise.new;
	my $blocked = ScriptedProvider.new(
		tools => [read-tool(),], results => { fs_read => 'eventually' },
		block-call => { fs_read => $gate },
	);
	my $spawner = Spawner.new(
		scripts => { reviewer => review-script() }, provider => $blocked,
	);
	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]),
		types => types(), spawn => $spawner.callback,
	);

	my $call = start $subagents.execute-tool-calls(
		[task-call('c1', 'reviewer', 'review the diff'),],
	).head;
	wait-until({ $subagents.live-agents.elems == 1 }, 'the child to start');

	is $subagents.cancel-children, 1, 'one child was asked to stop';

	await Promise.anyof($call, Promise.in(TIMEOUT));
	is $call.status, Kept, 'the task call settled rather than hanging';
	ok $call.result<is_error>,
		'as an error: a cancelled child produced no answer';

	$gate.keep(True);
};

subtest 'the parent transcript records both envelopes, and replays without the child' => {
	plan 9;

	my $path = fresh-path();
	my $session = test-session(
		path => $path, meta => { agent => 'test' },
	);

	my $spawner = Spawner.new(
		scripts => { reviewer => review-script('the diff is fine') },
		provider => child-provider(),
	);
	my $loop;
	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]),
		types => types(), spawn => $spawner.callback, loop => { $loop },
		:$session,
	);

	my $backend = scripted-backend(steps => [
		{ content => 'delegating',
		  tool-calls => [task-call('c1', 'reviewer', 'review the diff', label => 'the diff'),] },
		{ content => 'it is fine' },
	]);
	$loop = LLM::Agent::Loop.new(
		backends => [$backend,], provider => $subagents, :$session,
	);

	my $run = $loop.run([msg('user', 'review this'),]);
	run-settled($run, 'the recorded run');
	drain-events($run);

	my @types = $session.events.map({ $_<type> }).List;
	is @types.grep({ $_ eq 'subagent-spawned' }).elems, 1, 'one spawn line';
	is @types.grep({ $_ eq 'subagent-settled' }).elems, 1, 'one settle line';

	my %spawned = $session.events.first({ $_<type> eq 'subagent-spawned' })<payload>;
	is-deeply
		%spawned<agent-id agent-type prompt label>.List,
		('reviewer-1', 'reviewer', 'review the diff', 'the diff'),
		'the spawn line says who, what and why';
	ok %spawned<child-path>.ends-with('reviewer-1.jsonl'),
		'and points at the child transcript rather than copying it';
	is %spawned<call-id>, 'c1',
		'and names the task call it came from, which is what joins the '
			~ 'spawn line to the tool operation a few envelopes above it';

	my %settled = $session.events.first({ $_<type> eq 'subagent-settled' })<payload>;
	is %settled<outcome>, 'completed', 'the settle line has the outcome';
	is %settled<result>, 'the diff is fine',
		'and an excerpt of what the parent model was given';

	my Int $messages = $session.messages.elems;
	$session.close;

	# The whole point of append-event: a reader that has never heard of a
	# subagent replays the file without complaint, and needs none of the
	# children's files to do it.
	ok !$tmp.add('reviewer-1.jsonl').e,
		'the child transcript was never written by this test';
	my $replayed = reopen-session(path => $path);
	is $replayed.messages.elems, $messages,
		'and the parent replays to exactly the same conversation';
	$replayed.close;
};

subtest 'a spawn line written before call-id existed replays untouched' => {
	plan 4;

	# The compatibility case, spelled out as a file rather than as a
	# claim: a transcript from before the key existed has spawn lines
	# without it, and a reader that treated the absence as damage would
	# refuse to open a conversation it can read perfectly well.
	my $path = fresh-path();
	my $session = test-session(path => $path, meta => { agent => 'test' });
	$session.append-message(msg('user', 'review this'));
	# Deliberately NOT through the composer: this is the OLD shape, and
	# writing it by hand is the only way to keep writing it once the
	# composer has moved on.
	$session.append-event(type => 'subagent-spawned', payload => %(
		'agent-id' => 'reviewer-1', 'agent-type' => 'reviewer',
		prompt => 'review the diff', label => 'the diff',
		'child-path' => '/gone/reviewer-1.jsonl',
	));
	$session.append-event(type => 'subagent-settled', payload => %(
		'agent-id' => 'reviewer-1', outcome => 'completed',
		result => 'the diff is fine',
	));
	$session.close;

	my $replayed;
	lives-ok { $replayed = reopen-session(path => $path) },
		'a transcript whose spawn line has no call-id still loads';

	my %spawned = $replayed.events.first({ $_<type> eq 'subagent-spawned' })<payload>;
	nok %spawned<call-id>.defined,
		'the key is simply absent — nothing was invented for it';
	is %spawned<agent-id>, 'reviewer-1', 'and everything beside it survived';
	is $replayed.messages.elems, 1,
		'with the conversation itself replayed as it always was';
	$replayed.close;
};

subtest 'what a child spent is recorded only when somebody was counting' => {
	plan 3;

	# The conditional key of the run result Map, carried through to the
	# settle envelope: absent means NOBODY WAS COUNTING, which is a
	# different answer from "nothing was spent" and must not collapse
	# into a zero.
	sub settled(Int $context-budget --> Hash) {
		my $path = fresh-path();
		my $session = test-session(path => $path, meta => {});

		my &spawn = -> %spec {
			my $backend = scripted-backend(steps => [
				{ content => 'counted', usage => { prompt => 40, completion => 8 } },
			]);
			ChildHandle.new(
				run => LLM::Agent::Loop.new(
					backends => [$backend,],
					|($context-budget.defined ?? (:$context-budget) !! ()),
				).run([msg('user', %spec<prompt>),]),
				session-path => '',
			);
		};

		my $subagents = LLM::Agent::Subagents.new(
			inner => ScriptedProvider.new(tools => [read-tool(),]),
			types => types(), :&spawn, :$session,
		);
		$subagents.execute-tool-calls(
			[task-call('c1', 'reviewer', 'count something'),],
		);

		my %payload =
			$session.events.first({ $_<type> eq 'subagent-settled' })<payload>;
		$session.close;
		%payload;
	}

	my %counted = settled(128_000);
	ok %counted<spent>:exists, 'a child with a budget says what it spent';
	is %counted<spent><total-tokens>, 48,
		'the tokens the provider billed it for';

	nok settled(Int)<spent>:exists,
		'and one without a budget says nothing at all, rather than zero';
};

subtest 'everything that is not a task call goes through untouched' => {
	plan 5;

	my $inner = ScriptedProvider.new(
		tools => [read-tool(),],
		responder => -> $name, $args, $id { "read $args for $id" },
	);
	my $spawner = Spawner.new(scripts => {
		reviewer => (({ content => 'reviewed' },)),
	});
	my $subagents = LLM::Agent::Subagents.new(
		inner => $inner, types => types(), spawn => $spawner.callback,
	);

	my %read = tool-call('c1', 'fs_read', '{"path":"a"}');
	my @results = $subagents.execute-tool-calls([
		%read,
		task-call('c2', 'reviewer', 'review it'),
		tool-call('c3', 'fs_read', '{"path":"b"}'),
	]).List;

	is @results.elems, 3, 'one result per call';
	is @results.map({ $_<tool_call_id> }).List, ('c1', 'c2', 'c3'),
		'in the order the calls came in, whatever route each took';
	is-deeply $inner.recorded-calls[0], %read,
		'the inner provider saw the call exactly as the model sent it';
	is @results[0]<content>, 'read {"path":"a"} for c1',
		"and its answer is the inner provider's, untouched";
	is @results[1]<content>, 'reviewed',
		'while the task call in the middle was answered by the child';
};

subtest 'wiring, and what a composer refuses to be built as' => {
	plan 11;

	my $inner = ScriptedProvider.new(tools => [read-tool(),]);
	my $spawner = Spawner.new(scripts => {
		reviewer => (({ content => 'done' },)),
	});

	# set-loop, the alternative to closing over a forward declaration.
	my $late = LLM::Agent::Subagents.new(
		inner => $inner, types => types(), spawn => $spawner.callback,
	);
	my $loop = LLM::Agent::Loop.new(
		backends => [scripted-backend(steps => [{ content => 'hi' },]),],
		provider => $late,
	);
	lives-ok { $late.set-loop($loop) }, 'set-loop takes a loop';
	lives-ok { $late.set-loop({ $loop }) }, 'and a Callable returning one';
	dies-ok { $late.set-loop('the loop') }, 'and nothing else';

	# A composer with no loop at all still delegates; it just has nowhere
	# to publish the child's events.
	my $loopless = LLM::Agent::Subagents.new(
		inner => $inner, types => types(), spawn => $spawner.callback,
	);
	nok $loopless.execute-tool-calls(
		[task-call('c1', 'reviewer', 'review it'),],
	).head<is_error>, 'a composer with no loop still runs a child';

	throws-like
		{ LLM::Agent::Subagents.new(
			inner => $inner, types => types(), spawn => $spawner.callback,
			loop => 'not a loop',
		) },
		Exception, message => /'Callable returning one'/,
		'a loop that is neither a Loop nor a Callable is refused at '
			~ 'construction';

	throws-like
		{ LLM::Agent::Subagents.new(
			inner => 'not a provider', types => types(),
			spawn => $spawner.callback,
		) },
		Exception, message => /'tools-for-llm'/,
		'and an inner that is not a provider';

	throws-like
		{ LLM::Agent::Subagents.new(
			inner => $inner, spawn => $spawner.callback,
			# NO trailing comma, deliberately: this is the trap.
			types => [{ name => 'reviewer', description => 'a' }],
		) },
		Exception, message => /'single-argument rule'/,
		'a lone type hash that Raku flattened into Pairs is caught with '
			~ 'the fix, not left to fail somewhere else';

	throws-like
		{ LLM::Agent::Subagents.new(
			inner => $inner, spawn => $spawner.callback, types => [],
		) },
		Exception, message => /'types is empty'/,
		'an empty table is refused';

	throws-like
		{ LLM::Agent::Subagents.new(
			inner => $inner, spawn => $spawner.callback,
			types => (
				{ name => 'reviewer', description => 'a' },
				{ name => 'reviewer', description => 'b' },
			),
		) },
		Exception, message => /'both called'/,
		'and so are two types with one name';

	throws-like
		{ LLM::Agent::Subagents.new(
			inner => $inner, spawn => $spawner.callback,
			types => ({ name => 'reviewer' }, { name => 'tester', description => 'b' }),
		) },
		Exception, message => /'no description'/,
		'a type with no description';

	throws-like
		{ LLM::Agent::Subagents.new(
			inner => $inner, types => types(), spawn => $spawner.callback,
			max-live => 0,
		) },
		Exception, message => /'max-live'/,
		'and a composer that could never run anything';
};

subtest 'a spawn callback that goes wrong is an error, not an exception' => {
	plan 6;

	my $inner = ScriptedProvider.new(tools => [read-tool(),]);

	sub composer(&spawn --> LLM::Agent::Subagents) {
		LLM::Agent::Subagents.new(
			inner => $inner, types => types(), :&spawn,
		);
	}

	sub answer($subagents --> Hash) {
		$subagents.execute-tool-calls(
			[task-call('c1', 'reviewer', 'review it'),],
		).head;
	}

	my $threw = composer(-> %spec { die 'no capacity' });
	my %died = answer($threw);
	ok %died<is_error>, 'a callback that throws becomes an error result';
	ok %died<content>.contains('no capacity'),
		'carrying what it said';
	is $threw.live-agents.elems, 0, 'and the slot it reserved is released';

	ok answer(composer(-> %spec { 'a string' }))<is_error>,
		'a callback that answers with something unshaped';
	ok answer(composer(-> %spec { Nil }))<is_error>,
		'or with nothing at all';

	# A handle of the right shape whose .run is not a Run: the one a
	# `.can`-only check would let through into an await that never ends.
	my $wrong = composer(-> %spec {
		class { has $.run = 'not a run'; has Str $.session-path = '' }.new;
	});
	ok answer($wrong)<is_error>,
		'or with a handle whose run is not a Run';
};

subtest 'emit-external is the seam, and it refuses rather than racing' => {
	plan 6;

	my $gate = Promise.new;
	my $provider = ScriptedProvider.new(
		tools => [read-tool(),], results => { fs_read => 'eventually' },
		block-call => { fs_read => $gate },
	);
	my $backend = scripted-backend(steps => [
		{ content => 'hello' },
		{ content => 'again', tool-calls => [tool-call('c1', 'fs_read', '{}'),] },
		{ content => 'done' },
	]);
	my $loop = LLM::Agent::Loop.new(backends => [$backend,], :$provider);

	sub note-event(--> LLM::Agent::Event) {
		LLM::Agent::Event::Log.new(
			level => 'info', logger => 'test', data => 'from outside',
		);
	}

	nok $loop.emit-external(note-event()),
		'with no run ever started there is nothing to publish onto';

	my $run = $loop.run([msg('user', 'hi'),]);
	run-settled($run, 'the first run');
	my @events = drain-events($run);

	nok $loop.emit-external(note-event()),
		'and a finished run refuses rather than emitting after its terminal';
	is events-of(@events, 'log').elems, 0,
		'so nothing landed on it';

	throws-like
		{ $loop.emit-external(LLM::Agent::Event::RunCompleted.new(final => 'x')) },
		Exception, message => /'terminal'/,
		'a terminal event is a category error, not a race: only the loop '
			~ 'may end its own run';

	# And the live case, from a thread of its own — which is the whole
	# reason this exists. The run is held open by a blocked tool call, so
	# "live" is a fact here rather than a hope about scheduling.
	my $second = $loop.run([msg('user', 'again'),]);
	wait-until({ $provider.recorded-calls.elems == 1 },
		'the second run to reach its tool call');
	my $emitted = await start { $loop.emit-external(note-event()) };
	$gate.keep(True);
	run-settled($second, 'the second run');
	my @more = drain-events($second);

	ok $emitted, 'a live run takes it, from whichever thread it came from';
	is events-of(@more, 'log').elems, 1,
		'and it is published on that run, once';
};

subtest 'a settled child is billed to the run that asked for it' => {
	plan 9;

	# The composer's half of "a parent's budget caps its subtree": when a
	# child settles, its own `spent` record goes into the parent loop's
	# accumulators through `absorb-spend`, so the parent's caps see money
	# the parent's own attempts never spent.

	my @child-runs;
	my sub budgeted-spawner(Numeric:D $cost, *%child-caps --> Callable:D) {
		-> %spec {
			my $backend = scripted-backend(steps => [
				{ content => 'the child answers',
				  usage => { prompt => 200, completion => 100, cost => $cost } },
			]);
			my $loop = LLM::Agent::Loop.new(
				backends => [$backend,],
				# A budget of its own is what makes a run report `spent` at
				# all: without one there is nothing to absorb, on purpose.
				request-budget => LLM::Agent::RequestBudget.new(
					default-profile =>
						LLM::Agent::RequestBudget::Profile.new(
							context-window => 100_000),
					|%child-caps,
				),
			);
			my $run = $loop.run([msg('user', %spec<prompt>),]);
			@child-runs.push: %( :$run, :$loop );
			ChildHandle.new(run => $run, session-path => fresh-path().Str);
		};
	}

	my sub parent-run(&spawn, *%caps) {
		my $loop;
		my $subagents = LLM::Agent::Subagents.new(
			inner => ScriptedProvider.new(tools => [read-tool(),]),
			types => types(), :&spawn, loop => { $loop },
		);
		my $backend = scripted-backend(steps => [
			{ content => 'delegating',
			  usage => { prompt => 10, completion => 5, cost => 0.1e0 },
			  tool-calls => [task-call('t1', 'reviewer', 'review this'),] },
			{ content => 'and here is what it said',
			  usage => { prompt => 10, completion => 5, cost => 0.1e0 } },
		]);
		$loop = LLM::Agent::Loop.new(
			backends => [$backend,], provider => $subagents,
			request-budget => LLM::Agent::RequestBudget.new(
				default-profile => LLM::Agent::RequestBudget::Profile.new(
					context-window => 100_000),
				|%caps,
			),
		);
		my $run = $loop.run([msg('user', 'get this reviewed'),]);
		run-settled($run, 'the delegating run');
		%( outcome => (await $run.result), events => drain-events($run) );
	}

	# --- The ordinary case ---------------------------------------------
	my %fine = parent-run(budgeted-spawner(0.5e0));
	is %fine<outcome><outcome>, 'completed', 'the delegation ran and answered';
	is %fine<outcome><spent><cost>, 0.7e0,
		"the parent's bill is its own two attempts plus the child's one";
	is %fine<outcome><spent><total-tokens>, 30 + 300,
		'and its tokens, the same way';

	my @settled = events-of(%fine<events>, 'subagent')
		.grep({ (.inner<kind> // '') eq 'run-completed' });
	is @settled.elems, 1, 'the child really did complete';

	# The envelope and the absorb are the same numbers, deliberately: the
	# transcript records what the parent was billed.
	my $child-spent = (await @child-runs[0]<run>.result)<spent>;
	is $child-spent<cost>, 0.5e0, 'and its own record says what it cost';

	# --- SABOTAGE: the child is what puts the parent over --------------
	@child-runs = ();
	my %over = parent-run(budgeted-spawner(0.6e0), max-cost => 0.5e0);
	is %over<outcome><outcome>, 'failed',
		'a child whose spend crosses the parent cap ends the parent run';
	is %over<outcome><reason>, 'budget-exhausted',
		'with the budget\'s ordinary reason';
	is events-of(%over<events>, 'attempt-started').elems, 1,
		'and the parent never made its next attempt: the delegation '
			~ 'settled first, and the boundary after it refused';

	# --- A child nobody counted is not billed for zero -----------------
	@child-runs = ();
	my %uncounted = parent-run(-> %spec {
		my $loop = LLM::Agent::Loop.new(
			backends => [scripted-backend(steps => [{ content => 'done' },]),],
		);
		my $run = $loop.run([msg('user', %spec<prompt>),]);
		@child-runs.push: %( :$run, :$loop );
		ChildHandle.new(run => $run, session-path => fresh-path().Str);
	});
	is %uncounted<outcome><spent><cost>, 0.2e0,
		'a child with no budget reports no spend, and nothing is invented '
			~ 'for it';
};

subtest 'a batch of task calls runs its children side by side' => {
	plan 5;

	# THE PARALLELISM PROOF, and it is a proof rather than a measurement:
	# every spawn waits at a barrier until all of them have arrived. A
	# composer that started them one after another would leave the first
	# one waiting for children that cannot be built until it returns — so
	# a serial batch takes BARRIER seconds per call and a concurrent one
	# takes as long as one child, which is what the clock below asserts.
	my constant SPAWNS = 4;
	my constant BARRIER = 5;

	my $lock = Lock.new;
	my Int $arrived = 0;
	my @ids;
	my $all-here = Promise.new;

	my &spawn = -> %spec {
		my Bool $last = $lock.protect: {
			@ids.push: %spec<agent-id>;
			(++$arrived) == SPAWNS;
		};
		$all-here.keep(True) if $last;

		# The barrier. A deadline rather than a bare await, so a
		# regression is a failed test and not a hung suite.
		await Promise.anyof($all-here, Promise.in(BARRIER));

		my $loop = LLM::Agent::Loop.new(
			backends => [scripted-backend(steps => [
				{ content => 'reviewed ' ~ %spec<prompt> },
			]),],
		);
		ChildHandle.new(
			run => $loop.run([msg('user', %spec<prompt>),]),
			session-path => '',
		);
	};

	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]), types => types(), :&spawn,
		max-live => SPAWNS,
	);

	my $started = now;
	my @results = $subagents.execute-tool-calls(
		(^SPAWNS).map({ task-call("t$_", 'reviewer', "review $_") }).List,
	);
	my $elapsed = now - $started;

	is $all-here.status, Kept,
		'every spawn was inside the callback at the same moment — the batch '
			~ 'really is concurrent';
	ok $elapsed < BARRIER,
		"and it took {$elapsed.round(0.01)}s rather than the {BARRIER}s a "
			~ 'serial batch would have spent waiting at the first barrier '
			~ 'alone';
	is @ids.elems, SPAWNS, 'one id per call';
	is @ids.unique.elems, SPAWNS,
		'and every one of them distinct: the counter mints under the same '
			~ 'lock the slot is taken under';
	is @results.map({ $_<tool_call_id> }).List,
		(^SPAWNS).map({ "t$_" }).List,
		'and the answers come back in the CALLER’s order, whatever order '
			~ 'the children finished in';
};

subtest 'concurrent spawns never over-admit: max-live still holds' => {
	plan 6;

	# SABOTAGE: twice as many calls as there are slots, all arriving at
	# once. The guards and the slot reservation are one critical section,
	# so the arithmetic has to come out exactly — never five children in
	# three slots, and never two children with one id.
	my constant SLOTS = 3;
	my constant CALLS = 6;

	my $lock = Lock.new;
	my Int $entered = 0;
	my @ids;
	my $hold = Promise.new;

	my &spawn = -> %spec {
		$lock.protect: { $entered++; @ids.push: %spec<agent-id> };
		# Held open so that every admitted child is still live while the
		# refusals are being decided.
		await Promise.anyof($hold, Promise.in(TIMEOUT));
		my $loop = LLM::Agent::Loop.new(
			backends => [scripted-backend(steps => [{ content => 'done' },]),],
		);
		ChildHandle.new(
			run => $loop.run([msg('user', %spec<prompt>),]), session-path => '',
		);
	};

	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]), types => types(), :&spawn, max-live => SLOTS,
	);

	my $batch = start $subagents.execute-tool-calls(
		(^CALLS).map({ task-call("t$_", 'reviewer', "review $_") }).List,
	);

	# The refusals are immediate; the admitted ones are parked. Wait for
	# the admissions rather than sleeping on it.
	wait-until({ $lock.protect({ $entered }) == SLOTS },
		'the slots to fill');
	is $lock.protect({ $entered }), SLOTS,
		'exactly as many children were started as there were slots';
	is $subagents.live-agents.elems, SLOTS,
		'and the table agrees: no slot was taken twice';

	$hold.keep(True);
	await Promise.anyof($batch, Promise.in(TIMEOUT));
	is $batch.status, Kept, 'the whole batch settles';

	my @results = $batch.result.List;
	is @results.elems, CALLS, 'every call is answered';
	is @results.grep({ $_<is_error> && $_<content>.contains('is the limit') })
		.elems, CALLS - SLOTS,
		'the ones there was no room for are refused in the words the model '
			~ 'can act on';
	is $lock.protect({ @ids.unique.elems }), SLOTS,
		'and no id was minted twice';
};

# === Strict task arguments ===
#
# The 2026-08-19 incident in one file. A provider generating a turn of
# three long briefs hit its completion cap inside the third one and —
# because constrained decoding closes what it opened — still emitted
# VALID JSON, with a finish reason saying nothing had gone wrong. What
# was left of the brief became key names. The call parsed, agent-type and
# prompt were both there, and the prompt was a stump; the composer
# spawned a subagent on it, and nobody could tell.

#|( The mangled call as it arrived: a real agent type, a prompt cut
    mid-sentence, and two fragments of the rest of the brief masquerading
    as arguments — one of them carrying the newlines it was written
    with. )
sub mangled-arguments(--> Str:D) {
	to-json(
		%(
			'agent-type'         => 'reviewer',
			prompt               => 'Review the diff in the payments module '
				~ 'and report every problem you find with the rounding of',
			"sh_run.\n\nCONTEXT" => 'the half of the brief that never fitted',
			art                  => 'and another fragment of it',
		),
		:!pretty,
	);
}

subtest 'a clipped task call is diagnosed as mangled, and nothing is started' => {
	plan 10;

	my $spawner = Spawner.new(scripts => {
		reviewer => (({ content => 'the review' },)),
	});
	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]),
		types => types(), spawn => $spawner.callback,
	);

	sub answer(Str:D $arguments --> Hash) {
		$subagents.execute-tool-calls(
			[tool-call('c1', 'task', $arguments),],
		).head;
	}

	my %incident = answer(mangled-arguments());
	ok %incident<is_error>,
		'the call that parses, has both required keys, and is a lie is '
			~ 'refused';
	ok %incident<content>.contains(q['sh_run. CONTEXT']),
		'the refusal names the first of the junk keys — flattened onto one '
			~ 'line, because a key that carries newlines is not really a key';
	ok %incident<content>.contains(q['art']),
		'and the second: naming one of them would leave the model guessing '
			~ 'which of its arguments was wrong';
	ok %incident<content>.contains(q['agent-type'])
		&& %incident<content>.contains(q['prompt'])
		&& %incident<content>.contains(q['label']),
		'it names every key a task call may carry, so the model does not '
			~ 'have to remember the schema to recover';
	ok %incident<content>.contains('cut off')
		&& %incident<content>.contains('Re-emit'),
		'and it teaches the actual lesson: this is what a truncated '
			~ 'generation looks like, so send the whole call again';
	ok %incident<content>.contains('complete task'),
		'with the whole brief in the prompt, rather than the stump that '
			~ 'arrived';

	is $spawner.count, 0,
		'and NOT ONE child was started: the mangled call is refused before '
			~ 'anything is spawned, reserved or counted';

	# A decorated call is refused by the same rule. The ruling is strict
	# for `task` alone, and this is what strict costs.
	my %decorated = answer(
		'{"agent-type":"reviewer","prompt":"review the diff",'
			~ '"label":"diff","priority":"high"}',
	);
	ok %decorated<is_error>,
		'an otherwise perfect call with one invented key is refused too — '
			~ 'the check cannot tell a decoration from a fragment, and the '
			~ 'fragment is the one that matters';

	# The unknown-key check runs FIRST, and this is where that shows: the
	# call has no `agent-type` at all, but saying "no agent-type" would
	# send the model looking for a key it thinks it wrote.
	my %cased = answer('{"Agent-Type":"reviewer","prompt":"review the diff"}');
	ok %cased<is_error> && %cased<content>.contains(q['Agent-Type']),
		'a key that differs only in case is unknown — JSON keys are '
			~ 'case-sensitive and so is this';
	is $spawner.count, 0,
		'still nothing spawned, three refusals later';
};

subtest 'a reason argument is tolerated, and only the junk is named' => {
	plan 6;

	# MCP::Client's reasons layer adds `reason` to every declaration on the
	# way out and strips it on the way down — but it is stacked only when
	# its host turns reasons on, and a model asked for a reason on every
	# call for a whole conversation writes one here regardless.
	my $spawner = Spawner.new(scripts => {
		reviewer => (({ content => 'the review' },)),
	});
	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]),
		types => types(), spawn => $spawner.callback,
	);

	my Int $call-number = 0;
	sub answer(Str:D $arguments --> Hash) {
		$subagents.execute-tool-calls(
			[tool-call('r' ~ $call-number++, 'task', $arguments),],
		).head;
	}

	my %reasoned = answer(
		'{"agent-type":"reviewer","prompt":"review the diff",'
			~ '"reason":"the diff is large enough to be worth a whole run"}',
	);
	nok %reasoned<is_error>,
		'a task call carrying a reason is accepted — refusing a delegation '
			~ 'over a habit the harness taught the model would be the check '
			~ 'doing harm';
	is %reasoned<content>, 'the review', 'and the child really answered';
	is $spawner.count, 1, 'so the child really was started';

	my %mixed = answer(
		'{"agent-type":"reviewer","prompt":"review the other diff",'
			~ '"label":"other","reason":"because","scratch":"junk"}',
	);
	ok %mixed<is_error>, 'junk alongside a reason is still junk';
	ok %mixed<content>.contains(q[not part of it: 'scratch'.]),
		'and the refusal names the junk key and ONLY it: neither the '
			~ 'tolerated reason nor the declared label is an offence';
	is $spawner.count, 1, 'nothing else was spawned';
};

subtest 'the older refusals still say what they always said' => {
	plan 6;

	my $spawner = Spawner.new(scripts => { reviewer => review-script() });
	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]),
		types => types(), spawn => $spawner.callback,
	);

	sub answer(Str:D $arguments --> Hash) {
		$subagents.execute-tool-calls(
			[tool-call('c1', 'task', $arguments),],
		).head;
	}

	# Strictness sits in FRONT of these, so each one has to still be
	# reached by the call it was written for.
	ok answer('not json at all')<content>.contains('not a JSON object'),
		'arguments that are not an object are still refused as such';
	ok answer('{"prompt":"do it"}')<content>.contains('no agent-type'),
		'a call whose only fault is a missing agent-type still says so';
	ok answer('{"agent-type":"designer","prompt":"do it"}')<content>
		.contains(q['reviewer', 'tester']),
		'an agent type nobody registered still lists the ones that exist';
	ok answer('{"agent-type":"reviewer"}')<content>.contains('no prompt'),
		'and a call with no prompt still says THAT, rather than being '
			~ 'caught by the unknown-key check on the way past';
	ok answer('{"agent-type":"reviewer","prompt":"  "}')<is_error>,
		'a whitespace prompt is as empty as it ever was';

	is $spawner.count, 0, 'none of them started anything';
};

subtest 'the allow-list is generic, and the description carries the doctrine' => {
	plan 6;

	# The helper is deliberately not about `task`: the tools this composer
	# grows next check their own calls against their own declarations with
	# it.
	is-deeply LLM::Agent::Subagents::unknown-argument-keys(
		%( 'agent-type' => 'r', prompt => 'p', junk => 1 ),
		('agent-type', 'prompt', 'label'),
	), ('junk',), 'it names the keys the allow-list does not';

	is-deeply LLM::Agent::Subagents::unknown-argument-keys(
		%( zeta => 1, alpha => 2 ), ('known',),
	), ('alpha', 'zeta'),
		'sorted, so one mangled call refuses with the same words however '
			~ 'its keys happened to be ordered';

	is-deeply LLM::Agent::Subagents::unknown-argument-keys(
		%( anything => 1, 'at-all' => 2 ), (),
	), (),
		'an EMPTY allow-list names nothing — a declaration without '
			~ 'properties describes no arguments, and reading that as '
			~ '"every key is unknown" would turn an unreadable schema into '
			~ 'a tool that refuses every call it is given';

	is-deeply LLM::Agent::Subagents::unknown-argument-keys(
		%(), ('agent-type',),
	), (), 'a call with no arguments has nothing unknown in it';

	my $subagents = LLM::Agent::Subagents.new(
		inner => ScriptedProvider.new(tools => [read-tool(),]),
		types => types(), spawn => -> %spec { Nil },
	);
	my %task = $subagents.tools-for-llm.first({
		$_<function><name> eq 'task';
	});
	my $description = %task<function><description>;

	ok $description.contains('A brief is worth its length'),
		'the description tells the model that a brief may be as long as it '
			~ 'needs to be — batching guidance without it reads as an '
			~ 'instruction to compress, and a compressed brief is the same '
			~ 'lost context arrived at on purpose';
	ok $description.contains('splitting the spawns across turns is fine')
		&& $description.contains('run concurrently'),
		'and it says so BESIDE the batching guidance, which is unchanged';
};
